# Public variables (NEXT_PUBLIC_* are exposed to the client)
NEXT_PUBLIC_BASE_URL=https://ledgerly.vercel.app
NEXT_PUBLIC_ANALYTICS_ID=

# Local database (adjust user/password as needed for your Docker/Postgres setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgerly?schema=public"

# NextAuth / sessions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (password reset / notifications)
EMAIL_FROM="Ledgerly <no-reply@ledgerly.dev>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Notes:
# - Never commit real secrets, only placeholders.
# - Generate NEXTAUTH_SECRET with `openssl rand -base64 32` or similar.
# - For variables accessible on the client, use the NEXT_PUBLIC_ prefix.